<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const INITIAL_URL = "__URL__";

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x030008);
scene.fog = new THREE.FogExp2(0x030008, 0.015);

const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 500);
camera.position.set(0, 2.2, 6);
camera.lookAt(0, 2, 0);

const renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('canvas'), antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.xr.enabled = true;

scene.add(new THREE.AmbientLight(0x404060, 0.7));
const dirLight = new THREE.DirectionalLight(0xffffff, 1.0);
dirLight.position.set(8, 15, 10);
scene.add(dirLight);
const rimLight1 = new THREE.PointLight(0x00f0ff, 3.0, 40);
rimLight1.position.set(-8, 6, -8);
scene.add(rimLight1);
const rimLight2 = new THREE.PointLight(0xff00c8, 2.5, 40);
rimLight2.position.set(8, 6, -8);
scene.add(rimLight2);

const floorGeo = new THREE.PlaneGeometry(300, 300);
const floorMat = new THREE.MeshStandardMaterial({ color: 0x0a0a12, metalness: 0.95, roughness: 0.3 });
const floor = new THREE.Mesh(floorGeo, floorMat);
floor.rotation.x = -Math.PI / 2;
floor.position.y = -2;
scene.add(floor);

const grid = new THREE.GridHelper(300, 150, 0x00f0ff, 0x003344);
grid.position.y = -1.99;
grid.material.opacity = 0.25;
grid.material.transparent = true;
scene.add(grid);

// Etoiles
const starGeo = new THREE.BufferGeometry();
const starCount = 2000;
const starPos = new Float32Array(starCount * 3);
for (let i = 0; i < starCount; i++) {
starPos[i*3] = (Math.random() - 0.5) * 400;
starPos[i*3+1] = Math.random() * 100 - 20;
starPos[i*3+2] = (Math.random() - 0.5) * 400;
}
starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
const stars = new THREE.Points(starGeo, new THREE.PointsMaterial({
color: 0xffffff, size: 0.3, transparent: true, opacity: 0.7, blending: THREE.AdditiveBlending,
}));
scene.add(stars);

// ECRAN
let ecranPrincipal = null;
let bordures = [];
let satellites = [];
let modeActuel = 'flat';
let textureActuelle = null;

function creerCanvasVide() {
const canvas = document.createElement('canvas');
canvas.width = 1920;
canvas.height = 1080;
const ctx = canvas.getContext('2d');
const grad = ctx.createLinearGradient(0, 0, 0, 1080);
grad.addColorStop(0, '#030008');
grad.addColorStop(1, '#0a0520');
ctx.fillStyle = grad;
ctx.fillRect(0, 0, 1920, 1080);
ctx.fillStyle = '#00f0ff';
ctx.font = 'bold 80px monospace';
ctx.textAlign = 'center';
ctx.fillText('NEXUS WEB VR', 960, 500);
ctx.fillStyle = '#5a8a9a';
ctx.font = '32px monospace';
ctx.fillText('Chargement du site...', 960, 580);
return new THREE.CanvasTexture(canvas);
}

function creerEcranPrincipal() {
if (ecranPrincipal) {
scene.remove(ecranPrincipal);
ecranPrincipal.geometry.dispose();
ecranPrincipal.material.dispose();
ecranPrincipal = null;
}
bordures.forEach(b => scene.remove(b));
bordures = [];
satellites.forEach(s => scene.remove(s));
satellites = [];

let geo, largeur = 8, hauteur = 4.5;
let position = new THREE.Vector3(0, 2, 0);
let rotation = new THREE.Euler(0, 0, 0);

if (modeActuel === 'flat') {
geo = new THREE.PlaneGeometry(largeur, hauteur, 1, 1);
} else if (modeActuel === 'curved') {
geo = new THREE.CylinderGeometry(7, 7, hauteur, 64, 1, true, -Math.PI / 3.5, Math.PI * 2 / 3.5);
position.set(0, 2, -7);
} else if (modeActuel === 'dome') {
geo = new THREE.SphereGeometry(8, 64, 64, 0, Math.PI * 2, Math.PI / 3, Math.PI / 3);
} else if (modeActuel === 'cinema') {
largeur = 14; hauteur = 7.5;
geo = new THREE.PlaneGeometry(largeur, hauteur, 1, 1);
position.set(0, 2.5, -2);
} else if (modeActuel === 'window') {
largeur = 5; hauteur = 3;
geo = new THREE.PlaneGeometry(largeur, hauteur, 1, 1);
position.set(-3, 2, 0);
} else if (modeActuel === 'phone') {
largeur = 2.5; hauteur = 5;
geo = new THREE.PlaneGeometry(largeur, hauteur, 1, 1);
position.set(0, 2.5, 0);
} else if (modeActuel === 'wall') {
largeur = 20; hauteur = 10;
geo = new THREE.PlaneGeometry(largeur, hauteur, 1, 1);
position.set(0, 4, -3);
} else {
geo = new THREE.PlaneGeometry(6, 3.5, 1, 1);
}

const mat = new THREE.MeshBasicMaterial({
color: 0xffffff, side: THREE.DoubleSide, toneMapped: false,
});
mat.map = textureActuelle || creerCanvasVide();

ecranPrincipal = new THREE.Mesh(geo, mat);
ecranPrincipal.position.copy(position);
ecranPrincipal.rotation.copy(rotation);
scene.add(ecranPrincipal);

if (modeActuel !== 'dome' && modeActuel !== 'curved') {
const bordGeo = new THREE.PlaneGeometry(largeur + 0.15, hauteur + 0.15);
const bordMat = new THREE.MeshBasicMaterial({ color: 0x00f0ff, side: THREE.DoubleSide });
const bord = new THREE.Mesh(bordGeo, bordMat);
bord.position.copy(position);
bord.position.z -= 0.01;
bord.rotation.copy(rotation);
scene.add(bord);
bordures.push(bord);
}

if (modeActuel === 'grid') {
const positions = [
{ x: -8, y: 2, z: 0, rotY: Math.PI / 4 },
{ x: 8, y: 2, z: 0, rotY: -Math.PI / 4 },
{ x: 0, y: 2, z: -8, rotY: 0 },
{ x: 0, y: 2, z: 8, rotY: Math.PI },
];
positions.forEach(p => {
const g = new THREE.PlaneGeometry(6, 3.5, 1, 1);
const m = new THREE.MeshBasicMaterial({
color: 0xffffff, side: THREE.DoubleSide, toneMapped: false,
map: textureActuelle || creerCanvasVide(),
});
const sat = new THREE.Mesh(g, m);
sat.position.set(p.x, p.y, p.z);
sat.rotation.y = p.rotY;
scene.add(sat);
satellites.push(sat);
});
}
}

function majTexture(imageB64) {
const img = new Image();
img.onload = () => {
const canvas = document.createElement('canvas');
canvas.width = 1920;
canvas.height = 1080;
const ctx = canvas.getContext('2d');
ctx.drawImage(img, 0, 0, 1920, 1080);
const tex = new THREE.CanvasTexture(canvas);
tex.minFilter = THREE.LinearFilter;
tex.magFilter = THREE.LinearFilter;
textureActuelle = tex;
if (ecranPrincipal) {
ecranPrincipal.material.map = tex;
ecranPrincipal.material.needsUpdate = true;
}
bordures.forEach(b => {
if (b.material && b.material.map !== undefined && !b.material.color.equals(new THREE.Color(0x00f0ff))) {
b.material.map = tex;
b.material.needsUpdate = true;
}
});
satellites.forEach(s => {
s.material.map = tex;
s.material.needsUpdate = true;
});
document.getElementById('loader').style.display = 'none';
};
img.src = 'data:image/png;base64,' + imageB64;
}

async function chargerURL() {
const input = document.getElementById('url-input');
const url = input.value.trim();
if (!url) return;

const loader = document.getElementById('loader');
const loaderText = document.getElementById('loader-text');
loader.style.display = 'block';
loaderText.textContent = 'Chargement ' + url.substring(0, 50) + '...';

try {
const r = await fetch('/api/capture?url=' + encodeURIComponent(url));
const data = await r.json();

if (data.ok && data.image_b64) {
majTexture(data.image_b64);
afficherLiens(data.liens || []);
document.getElementById('liens-count').textContent = (data.liens || []).length + ' liens';
document.getElementById('methode').textContent = data.methode || '-';
} else {
loaderText.textContent = 'Erreur : ' + (data.erreur || 'inconnu');
}
} catch(e) {
loaderText.textContent = 'Erreur réseau : ' + e.message;
}
}

function afficherLiens(liens) {
const list = document.getElementById('liens-list');
list.innerHTML = '';
liens.forEach(l => {
const a = document.createElement('a');
a.textContent = l[0] + ' → ' + l[1];
a.title = l[1];
a.onclick = () => {
document.getElementById('url-input').value = l[1];
chargerURL();
};
list.appendChild(a);
});
}

function toggleLiens() {
document.getElementById('liens-overlay').classList.toggle('open');
}

function setMode(mode) {
modeActuel = mode;
document.querySelectorAll('.controls .btn').forEach(b => {
if (b.dataset.mode === mode) b.classList.add('active');
else b.classList.remove('active');
});
creerEcranPrincipal();
}

function resetCamera() {
camera.position.set(0, 2.2, 6);
camera.lookAt(0, 2, 0);
rotY = 0; rotX = 0;
rotYTarget = 0; rotXTarget = 0;
distance = 6; distanceTarget = 6;
}

function toggleVR() {
if (renderer.xr.isPresenting) {
renderer.xr.getSession().end();
} else if (navigator.xr) {
navigator.xr.requestSession('immersive-vr', { optionalFeatures: ['local-floor'] }).then(session => {
renderer.xr.setSession(session);
}).catch(e => {
alert('VR non disponible : ' + e.message);
});
} else {
alert('WebXR non supporté.');
}
}

// CONTROLES
let sourisDown = false;
let sourisX = 0, sourisY = 0;
let rotY = 0, rotX = 0;
let rotYTarget = 0, rotXTarget = 0;
let distance = 6, distanceTarget = 6;

document.addEventListener('mousedown', (e) => { sourisDown = true; sourisX = e.clientX; sourisY = e.clientY; });
document.addEventListener('mouseup', () => { sourisDown = false; });
document.addEventListener('mousemove', (e) => {
if (sourisDown) {
rotYTarget += (e.clientX - sourisX) * 0.005;
rotXTarget += (e.clientY - sourisY) * 0.003;
rotXTarget = Math.max(-0.6, Math.min(0.6, rotXTarget));
sourisX = e.clientX; sourisY = e.clientY;
}
});
document.addEventListener('wheel', (e) => {
distanceTarget += e.deltaY * 0.005;
distanceTarget = Math.max(2, Math.min(20, distanceTarget));
}, { passive: true });

document.addEventListener('touchstart', (e) => { sourisDown = true; sourisX = e.touches[0].clientX; sourisY = e.touches[0].clientY; });
document.addEventListener('touchend', () => { sourisDown = false; });
document.addEventListener('touchmove', (e) => {
if (sourisDown && e.touches.length > 0) {
rotYTarget += (e.touches[0].clientX - sourisX) * 0.005;
rotXTarget += (e.touches[0].clientY - sourisY) * 0.003;
rotXTarget = Math.max(-0.6, Math.min(0.6, rotXTarget));
sourisX = e.touches[0].clientX; sourisY = e.touches[0].clientY;
}
}, { passive: true });

let t = 0;
let frames = 0;
let lastFpsUpdate = performance.now();
const clock = new THREE.Clock();

renderer.setAnimationLoop(() => {
const dt = Math.min(clock.getDelta(), 0.05);
t += dt;

rotY += (rotYTarget - rotY) * 0.1;
rotX += (rotXTarget - rotX) * 0.1;
distance += (distanceTarget - distance) * 0.1;

const camX = Math.sin(rotY) * distance;
const camZ = Math.cos(rotY) * distance;
const camY = 2 + rotX * 3;

camera.position.x += (camX - camera.position.x) * 0.1;
camera.position.y += (camY - camera.position.y) * 0.1;
camera.position.z += (camZ - camera.position.z) * 0.1;
camera.lookAt(0, 2, 0);

rimLight1.intensity = 3.0 + Math.sin(t * 1.5) * 0.5;
rimLight2.intensity = 2.5 + Math.sin(t * 1.8 + 1) * 0.5;
stars.rotation.y = t * 0.005;

frames++;
if (performance.now() - lastFpsUpdate > 1000) {
document.getElementById('fps').textContent = frames + ' FPS';
frames = 0;
lastFpsUpdate = performance.now();
}

renderer.render(scene, camera);
});

window.addEventListener('resize', () => {
camera.aspect = window.innerWidth / window.innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(window.innerWidth, window.innerHeight);
});

document.getElementById('url-input').addEventListener('keydown', (e) => {
if (e.key === 'Enter') chargerURL();
});

creerEcranPrincipal();
console.log('NEXUS WEB VR v__V__ — Auteur : Aissa Mohammedi (DGK)');
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
def log_message(self, *a):
pass

def _send(self, code, content, ctype="text/html; charset=utf-8"):
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Cache-Control", "no-cache")
self.send_header("Content-Length", str(len(content)))
self.end_headers()
self.wfile.write(content)
except (BrokenPipeError, ConnectionResetError):
pass

def do_GET(self):
parsed = urllib.parse.urlparse(self.path)
p = parsed.path
q = urllib.parse.parse_qs(parsed.query)

if p in ("/", "/index.html"):
html = HTML_TEMPLATE.replace("__V__", VERSION).replace("__URL__", DEFAULT_URL)
return self._send(200, html.encode("utf-8"))

if p == "/api/capture":
url = q.get("url", [DEFAULT_URL])[0]
r = capturer_site(url)
return self._send(200, json.dumps(r, ensure_ascii=False).encode(), "application/json")

if p == "/api/health":
return self._send(200, json.dumps({"ok": True, "version": VERSION, "outils": AVAILABLE}).encode(), "application/json")

return self._send(404, b'{"erreur":"not found"}', "application/json")


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


def ip_locale():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "localhost"


