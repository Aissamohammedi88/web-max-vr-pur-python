def capturer_pillow(url, timeout=25):
"""Rendu HTML simplifie avec Pillow — extrait couleurs, titre, texte."""
if not AVAILABLE["pillow"]:
return None

if not url.startswith("http"):
url = "https://" + url

try:
req = urllib.request.Request(url, headers={
"User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1",
"Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
"Accept-Language": "fr-FR,fr;q=0.9,en;q=0.8",
"Accept-Encoding": "gzip, deflate",
})
with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:
raw = r.read(2000000)
enc = r.headers.get("Content-Encoding", "").lower()
if "gzip" in enc:
import gzip
try:
raw = gzip.decompress(raw)
except Exception:
pass
html = raw.decode("utf-8", "ignore")

# Extraire les couleurs CSS dominantes
couleurs = re.findall(r"#[0-9a-fA-F]{6}\b", html)
couleurs.extend(re.findall(r"#[0-9a-fA-F]{3}\b", html))
couleurs = [c for c in couleurs if c.lower() not in ("#000", "#fff", "#000000", "#ffffff")]
couleurs_count = {}
for c in couleurs:
couleurs_count[c.lower()] = couleurs_count.get(c.lower(), 0) + 1
top_couleurs = sorted(couleurs_count.items(), key=lambda x: -x[1])[:5]

# Background color
bg_match = re.search(r"background(?:-color)?\s*:\s*([#a-zA-Z0-9(),\s\.]+)", html, re.I)
bg_color = "#0a0a12"
if bg_match:
bg_c = bg_match.group(1).strip().split()[0].rstrip(";")
if bg_c.startswith("#") and len(bg_c) in (4, 7):
bg_color = bg_c

# Body style
body_match = re.search(r"<body[^>]*style=[\"']([^\"']+)", html, re.I)
if body_match:
style = body_match.group(1)
bg2 = re.search(r"background(?:-color)?\s*:\s*([#a-zA-Z0-9(),\s\.]+)", style, re.I)
if bg2:
bg_c = bg2.group(1).strip().split()[0].rstrip(";")
if bg_c.startswith("#") and len(bg_c) in (4, 7):
bg_color = bg_c

# Titre
titre_match = re.search(r"<title[^>]*>([^<]+)</title>", html, re.I)
titre = titre_match.group(1).strip() if titre_match else url

# Meta description
desc_match = re.search(r'<meta[^>]+name=["\']description["\'][^>]+content=["\']([^"\']+)', html, re.I)
description = desc_match.group(1).strip() if desc_match else ""

# Logo/favicon
favicon_match = re.search(r'<link[^>]+rel=["\'](?:icon|shortcut icon)["\'][^>]+href=["\']([^"\']+)', html, re.I)
favicon = favicon_match.group(1) if favicon_match else ""
if favicon:
if favicon.startswith("//"):
favicon = "https:" + favicon
elif favicon.startswith("/"):
parsed = urllib.parse.urlparse(url)
favicon = parsed.scheme + "://" + parsed.netloc + favicon

# Extraire les principales images (og:image ou hero image)
og_img = ""
og_match = re.search(r'<meta[^>]+property=["\']og:image["\'][^>]+content=["\']([^"\']+)', html, re.I)
if og_match:
og_img = og_match.group(1)

# Texte visible
html_clean = re.sub(r"<script[^>]*>.*?</script>", " ", html, flags=re.S | re.I)
html_clean = re.sub(r"<style[^>]*>.*?</style>", " ", html_clean, flags=re.S | re.I)
html_clean = re.sub(r"<[^>]+>", " ", html_clean)
texte = re.sub(r"\s+", " ", html_clean).strip()

# Liens
liens = []
for m in re.finditer(r'<a[^>]+href=["\']([^"\']+)["\'][^>]*>([^<]*)</a>', html, re.I):
href = m.group(1)
txt = re.sub(r"\s+", " ", m.group(2)).strip()
if txt and href and not href.startswith("#"):
if href.startswith("/"):
parsed = urllib.parse.urlparse(url)
href = parsed.scheme + "://" + parsed.netloc + href
liens.append([txt[:80], href[:200]])

# Generer l'image avec Pillow
from PIL import Image, ImageDraw, ImageFont

W, H = 1920, 1080

# Convertir la couleur de fond
def hex_to_rgb(h):
h = h.lstrip("#")
if len(h) == 3:
h = "".join([c*2 for c in h])
try:
return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))
except Exception:
return (10, 10, 18)

bg_rgb = hex_to_rgb(bg_color)

# Couleurs d'accent depuis le site
accent_rgb = (0, 240, 255)
if top_couleurs:
accent_rgb = hex_to_rgb(top_couleurs[0][0])

secondary_rgb = (255, 255, 255)
if len(top_couleurs) > 1:
secondary_rgb = hex_to_rgb(top_couleurs[1][0])

# Creer l'image
img = Image.new("RGB", (W, H), bg_rgb)
draw = ImageDraw.Draw(img)

# Gradient subtil
for y in range(H):
ratio = y / H
r = int(bg_rgb[0] * (1 - ratio * 0.3))
g = int(bg_rgb[1] * (1 - ratio * 0.3))
b = int(bg_rgb[2] * (1 - ratio * 0.3) + ratio * 20)
r = max(0, min(255, r))
g = max(0, min(255, g))
b = max(0, min(255, b))
draw.line([(0, y), (W, y)], fill=(r, g, b))

# Font
font_h1 = None
font_h2 = None
font_body = None
font_small = None
for f in [
"/System/Library/Fonts/Helvetica.ttc",
"/System/Library/Fonts/Supplemental/Arial.ttf",
"/System/Library/Fonts/Supplemental/Arial Bold.ttf",
"/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
"/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
]:
if os.path.exists(f):
try:
font_h1 = font_h1 or ImageFont.truetype(f, 64)
font_h2 = font_h2 or ImageFont.truetype(f, 36)
font_body = font_body or ImageFont.truetype(f, 22)
font_small = font_small or ImageFont.truetype(f, 16)
except Exception:
pass
if font_h1 is None: font_h1 = ImageFont.load_default()
if font_h2 is None: font_h2 = ImageFont.load_default()
if font_body is None: font_body = ImageFont.load_default()
if font_small is None: font_small = ImageFont.load_default()

# Barre du haut avec couleur d'accent
draw.rectangle([(0, 0), (W, 6)], fill=accent_rgb)

# Barre de titre simulant un navigateur
draw.rectangle([(0, 0), (W, 80)], fill=(20, 20, 30))
draw.rectangle([(0, 80), (W, 84)], fill=accent_rgb)

# URL en haut
draw.text((30, 30), url[:120], fill=accent_rgb, font=font_h2)

# Titre principal
y = 130
# Wrap titre
mots_titre = titre.split()
ligne = ""
for mot in mots_titre:
test = (ligne + " " + mot).strip()
if len(test) > 60:
draw.text((60, y), ligne, fill=secondary_rgb, font=font_h1)
y += 70
ligne = mot
if y > 400:
break
else:
ligne = test
if ligne and y <= 400:
draw.text((60, y), ligne, fill=secondary_rgb, font=font_h1)
y += 70

# Ligne separator
y += 20
draw.line([(60, y), (W - 60, y)], fill=accent_rgb, width=2)
y += 30

# Description
if description:
mots_desc = description.split()
ligne = ""
for mot in mots_desc:
test = (ligne + " " + mot).strip()
if len(test) > 110:
draw.text((60, y), ligne, fill=(180, 200, 220), font=font_body)
y += 30
ligne = mot
if y > 550:
break
else:
ligne = test
if ligne and y <= 550:
draw.text((60, y), ligne, fill=(180, 200, 220), font=font_body)
y += 40
y += 20

# Texte principal
mots_texte = texte.split()
ligne = ""
compteur = 0
for mot in mots_texte:
test = (ligne + " " + mot).strip()
if len(test) > 110:
draw.text((60, y), ligne, fill=(200, 220, 235), font=font_body)
y += 28
compteur += 1
ligne = mot
if compteur >= 12 or y > 950:
break
else:
ligne = test
if ligne and compteur < 12 and y <= 950:
draw.text((60, y), ligne, fill=(200, 220, 235), font=font_body)

# Pied de page
draw.rectangle([(0, H - 70), (W, H)], fill=(20, 20, 30))
draw.rectangle([(0, H - 74), (W, H - 70)], fill=accent_rgb)
draw.text((30, H - 50), "NEXUS WEB VR v" + VERSION + " — " + datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
fill=accent_rgb, font=font_small)
draw.text((W - 500, H - 50),
"Couleurs detectees: " + " ".join([c[0] for c in top_couleurs[:3]]),
fill=accent_rgb, font=font_small)

# Sauvegarder en PNG
buf = BytesIO()
img.save(buf, format="PNG", optimize=True)
png_bytes = buf.getvalue()

return {
"ok": True,
"url": url,
"titre": titre[:200],
"html": html,
"liens": liens[:50],
"png_bytes": png_bytes,
"couleurs": [c[0] for c in top_couleurs],
"methode": "pillow_fidele",
}

except Exception as e:
print("[Pillow erreur] " + str(e)[:200])
return None


