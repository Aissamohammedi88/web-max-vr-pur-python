def capturer_site(url):
"""Essaie toutes les methodes de capture dans l'ordre de fidelite."""
if not url.startswith("http"):
url = "https://" + url

# Cache
with CACHE_LOCK:
if url in CACHE:
return CACHE[url]

print("[CAPTURE] " + url)

# 1. Playwright (le plus fidele)
if AVAILABLE["playwright"]:
r = capturer_playwright(url)
if r and r.get("ok") and len(r.get("png_bytes", b"")) > 5000:
return finaliser(r)

# 2. Selenium
if AVAILABLE["selenium"]:
r = capturer_selenium(url)
if r and r.get("ok") and len(r.get("png_bytes", b"")) > 5000:
return finaliser(r)

# 3. Chromium headless
if AVAILABLE["chromium"]:
r = capturer_chromium(url)
if r and r.get("ok") and len(r.get("png_bytes", b"")) > 5000:
return finaliser(r)

# 4. wkhtmltoimage
if AVAILABLE["wkhtmltoimage"]:
r = capturer_wkhtmltoimage(url)
if r and r.get("ok") and len(r.get("png_bytes", b"")) > 5000:
return finaliser(r)

# 5. Fallback Pillow (rendu fidele du contenu)
if AVAILABLE["pillow"]:
r = capturer_pillow(url)
if r and r.get("ok"):
return finaliser(r)

return {"ok": False, "erreur": "Aucune methode de capture disponible. Installe Pillow : pip install Pillow"}


def finaliser(r):
"""Encode l'image en base64 et met en cache."""
b64 = base64.b64encode(r["png_bytes"]).decode("ascii")

resultat = {
"ok": True,
"url": r["url"],
"titre": r.get("titre", "")[:200],
"liens": r.get("liens", [])[:50],
"image_b64": b64,
"taille_image": len(b64),
"methode": r.get("methode", "?"),
"couleurs": r.get("couleurs", []),
"date": datetime.datetime.now(datetime.timezone.utc).isoformat(),
}

with CACHE_LOCK:
CACHE[r["url"]] = resultat
if len(CACHE) > MAX_CACHE:
oldest = min(CACHE.keys(), key=lambda k: CACHE[k].get("date", ""))
del CACHE[oldest]

print("[OK] Capture " + r["url"] + " via " + resultat["methode"] + " (" + str(resultat["taille_image"]) + " octets)")
return resultat


