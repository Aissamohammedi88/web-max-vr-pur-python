#!/bin/bash
# NEXUS WEB VR — INSTALLATEUR LINUX MINT
# Installe toutes les dépendances pour capturer les vrais sites
# avec Playwright/Chromium en VR.
# Auteur : Aissa Mohammedi (DGK)
# Licence : NEXUS-OPEN-2.0

set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

ok() { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[!!]${NC} $1"; }
err() { echo -e "${RED}[KO]${NC} $1"; }
info() { echo -e "${CYAN}[i]${NC} $1"; }

PROJECT_DIR="$HOME/nexus_webvr"
PYTHON_SCRIPT="$PROJECT_DIR/nexus_webvr.py"

echo "============================================================"
echo "NEXUS WEB VR — INSTALLATION LINUX MINT"
echo "Auteur : Aissa Mohammedi (DGK)"
echo "============================================================"
echo ""

# ═══════════════════════════════════════════════════════════════════
# 1. VERIFICATION SYSTEME
# ═══════════════════════════════════════════════════════════════════

info "Verification du systeme..."

if [ ! -f /etc/os-release ]; then
err "Distribution inconnue"
exit 1
fi

. /etc/os-release
echo "Distribution : $PRETTY_NAME"

if [ "$ID" != "linuxmint" ] && [ "$ID" != "ubuntu" ] && [ "$ID_LIKE" != *"ubuntu"* ]; then
warn "Teste sur Linux Mint/Ubuntu. Ta distribution : $ID"
fi

# ═══════════════════════════════════════════════════════════════════
# 2. MISE A JOUR SYSTEME
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Mise a jour du systeme (sudo requis)..."
sudo apt update -y
sudo apt upgrade -y

# ═══════════════════════════════════════════════════════════════════
# 3. INSTALLATION DES DEPENDANCES DE BASE
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Installation des outils de base..."

sudo apt install -y \
python3 \
python3-pip \
python3-venv \
python3-dev \
build-essential \
curl \
wget \
git \
ca-certificates \
libssl-dev \
libffi-dev \
libxml2-dev \
libxslt1-dev \
zlib1g-dev \
libjpeg-dev \
libpng-dev \
libfreetype6-dev \
libraqm-dev \
imagemagick \
ffmpeg

ok "Outils de base installes"

# ═══════════════════════════════════════════════════════════════════
# 4. INSTALLATION PILLOW (rendu images)
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Installation de Pillow..."

pip3 install --upgrade pip
pip3 install --user Pillow

python3 -c "from PIL import Image, ImageDraw, ImageFont; print('Pillow OK')" && ok "Pillow fonctionne"

# ═══════════════════════════════════════════════════════════════════
# 5. INSTALLATION PLAYWRIGHT (capture fidele)
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Installation de Playwright..."

pip3 install --user playwright

# Installer les dependances systeme de Playwright
info "Installation des dependances Chromium (peut prendre 2-3 min)..."
sudo apt install -y \
libnss3 \
libnspr4 \
libatk1.0-0 \
libatk-bridge2.0-0 \
libcups2 \
libdrm2 \
libdbus-1-3 \
libxkbcommon0 \
libatspi2.0-0 \
libxcomposite1 \
libxdamage1 \
libxfixes3 \
libxrandr2 \
libgbm1 \
libpango-1.0-0 \
libcairo2 \
libasound2 \
libatk-bridge2.0-0 \
libgtk-3-0

# Telecharger Chromium pour Playwright
python3 -m playwright install chromium
ok "Playwright + Chromium installes"

# ═══════════════════════════════════════════════════════════════════
# 6. INSTALLATION SELENIUM (optionnel, alternative)
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Installation de Selenium..."

pip3 install --user selenium

ok "Selenium installe"

# ═══════════════════════════════════════════════════════════════════
# 7. INSTALLATION WKHTMLTOIMAGE (optionnel)
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Installation de wkhtmltoimage..."

if command -v wkhtmltoimage >/dev/null 2>&1; then
ok "wkhtmltoimage deja installe"
else
sudo apt install -y wkhtmltopdf
if command -v wkhtmltoimage >/dev/null 2>&1; then
ok "wkhtmltoimage installe"
else
warn "wkhtmltoimage non installe (optionnel)"
fi
fi

# ═══════════════════════════════════════════════════════════════════
# 8. INSTALLATION CHROMIUM HEADLESS (alternative)
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Installation de Chromium..."

sudo apt install -y chromium-browser || sudo apt install -y chromium

if command -v chromium >/dev/null 2>&1; then
ok "Chromium installe"
elif command -v chromium-browser >/dev/null 2>&1; then
ok "Chromium-browser installe"
else
warn "Chromium non installe (Playwright a deja le sien)"
fi

# ═══════════════════════════════════════════════════════════════════
# 9. CREATION DU DOSSIER PROJET
# ═══════════════════════════════════════════════════════════════════

echo ""
info "Creation du dossier projet..."

mkdir -p "$PROJECT_DIR"
mkdir -p "$PROJECT_DIR/cache"
mkdir -p "$PROJECT_DIR/screenshots"

ok "Dossier : $PROJECT_DIR"

# ═══════════════════════════════════════════════════════════════════
# 10. VERIFICATION FINALE
# ═══════════════════════════════════════════════════════════════════

echo ""
echo "============================================================"
echo "VERIFICATION FINALE"
echo "============================================================"

# Pillow
if python3 -c "import PIL" 2>/dev/null; then
echo -e "${GREEN}[OK]${NC} Pillow"
else
echo -e "${RED}[KO]${NC} Pillow"
fi

# Playwright
if python3 -c "import playwright" 2>/dev/null; then
echo -e "${GREEN}[OK]${NC} Playwright"
else
echo -e "${RED}[KO]${NC} Playwright"
fi

# Selenium
if python3 -c "import selenium" 2>/dev/null; then
echo -e "${GREEN}[OK]${NC} Selenium"
else
echo -e "${RED}[KO]${NC} Selenium"
fi

# Chromium (Playwright)
if [ -d "$HOME/.cache/ms-playwright" ]; then
echo -e "${GREEN}[OK]${NC} Chromium Playwright"
else
echo -e "${YELLOW}[!!]${NC} Chromium Playwright absent"
fi

# wkhtmltoimage
if command -v wkhtmltoimage >/dev/null 2>&1; then
echo -e "${GREEN}[OK]${NC} wkhtmltoimage"
else
echo -e "${YELLOW}[!!]${NC} wkhtmltoimage absent (optionnel)"
fi

# Chromium systeme
if command -v chromium >/dev/null 2>&1 || command -v chromium-browser >/dev/null 2>&1; then
echo -e "${GREEN}[OK]${NC} Chromium systeme"
else
echo -e "${YELLOW}[!!]${NC} Chromium systeme absent"
fi

# Python
echo -e "${GREEN}[OK]${NC} $(python3 --version)"

# ═══════════════════════════════════════════════════════════════════
# 11. INSTRUCTIONS FINALES
# ═══════════════════════════════════════════════════════════════════

echo ""
echo "============================================================"
echo "INSTALLATION TERMINEE"
echo "============================================================"
echo ""
echo "Prochaines etapes :"
echo ""
echo "1. Copie le script nexus_webvr.py dans $PROJECT_DIR"
echo ""
echo " Option A — Depuis un autre PC :"
echo " scp nexus_webvr.py \$USER@\$(hostname):$PROJECT_DIR/"
echo ""
echo " Option B — Colle directement :"
echo " nano $PYTHON_SCRIPT"
echo " (colle le code Python, Ctrl+X, Y, Entree)"
echo ""
echo "2. Lance le serveur :"
echo " cd $PROJECT_DIR"
echo " python3 nexus_webvr.py"
echo ""
echo "3. Ouvre dans Firefox/Chrome :"
echo " http://localhost:8096/"
echo ""
echo "4. Teste avec l'URL par defaut (ton depot GitHub)"
echo ""
echo "============================================================"
echo "Depannage :"
echo "============================================================"
echo ""
echo "Si Playwright plante :"
echo " python3 -m playwright install-deps"
echo ""
echo "Si Chromium manque :"
echo " sudo apt install chromium-browser"
echo ""
echo "Si permission refusee sur pip :"
echo " pip3 install --user Pillow playwright selenium"
echo ""
echo "Pour tester Playwright seul :"
echo " python3 -c \"from playwright.sync_api import sync_playwright; print('OK')\""
echo ""
echo "============================================================"
echo "NEXUS WEB VR v3.0.0 — Aissa Mohammedi (DGK)"
echo "Licence NEXUS-OPEN-2.0"
echo "============================================================"
